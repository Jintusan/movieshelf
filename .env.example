# Copy this file to ".env" and fill in real values before starting the app.
# ".env" itself is git-ignored and must never be committed.

# Your personal TMDB API key (v3 "API Key"), get one for free at:
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Any long random string, used to sign the session cookie.
SESSION_SECRET=change_this_to_a_long_random_string

# Port the Express server listens on.
PORT=3000
